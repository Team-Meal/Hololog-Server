# docker-compose.prod.yml 용 환경변수 예시
# 서버에 .env 로 복사해서 실제 값으로 채우세요. (.env 는 절대 커밋 금지)

# GHCR 이미지 (CD가 export 하지만 수동 실행 대비 기본값)
APP_IMAGE=ghcr.io/owner/hololog-server:develop

# Database
DB_NAME=hororog
DB_USERNAME=hororog
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-root-password
DB_PORT=3306

# Redis
REDIS_PORT=6379

# App
SERVER_PORT=8080
JPA_DDL_AUTO=update
AI_SERVER_URL=http://change-me-ai-server-host:port

# CORS (쉼표로 여러 origin 가능, 끝에 슬래시(/)나 path 없이 scheme+host+port만 입력)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 저사양 서버 메모리 제한 (필요시 조정)
APP_MEM_LIMIT=512m
DB_MEM_LIMIT=512m
REDIS_MEM_LIMIT=160m
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError
